# =============================================================================
# SysteMIC Backend — Variables d'environnement
# =============================================================================
# Copier ce fichier en `.env` pour le développement local.
# En production, ces valeurs sont saisies dans l'onglet Variables de Railway.
# Ne JAMAIS committer le fichier `.env` réel.
# =============================================================================

# --- Application ---------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- Base de données ------------------------------------------------------
# LOCAL : PostgreSQL sur la machine de développement
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/systemic?schema=public"

# RAILWAY : ne pas coller l'URL en dur. Dans l'onglet Variables du service
# backend, créer DATABASE_URL avec cette valeur littérale — Railway la résout
# automatiquement au déploiement :
#
#   ${{Postgres.DATABASE_URL}}?connection_limit=10&pool_timeout=20&connect_timeout=10
#
# connection_limit borne le pool Prisma par instance. Postgres accepte 100
# connexions par défaut : 10 par instance autorise 10 instances en parallèle.

# --- Authentification -----------------------------------------------------
# Générer deux secrets DIFFÉRENTS de 64 caractères :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=remplacer_par_un_secret_aleatoire_de_64_caracteres_minimum
JWT_REFRESH_SECRET=remplacer_par_un_autre_secret_different_de_64_caracteres

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Mot de passe attribué aux comptes créés par un administrateur.
# L'utilisateur est forcé de le changer à la première connexion.
DEFAULT_USER_PASSWORD=Password123

# Compte super-administrateur créé par le seed
SUPER_ADMIN_EMAIL=admin@systemic.church
SUPER_ADMIN_PASSWORD=ChangeMoiImmediatement2026!

# --- CORS -----------------------------------------------------------------
# Origines autorisées, séparées par des virgules.
# En développement, Flutter Web utilise un port aléatoire : autoriser localhost.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# --- Limitation de débit --------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --- Notifications push (Firebase) ---------------------------------------
# Optionnel : laisser vide désactive proprement les notifications push.
# Coller le contenu JSON du compte de service sur UNE seule ligne.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Règles métier --------------------------------------------------------
# Valeurs de repli si la table task_penalty_settings est vide
DEFAULT_DAILY_PENALTY_AMOUNT=100
BLOCKING_THRESHOLD_AMOUNT=3500
TEACHING_TASK_DUE_OFFSET_DAYS=10

# Graduation automatique des nouveaux venus
NEWCOMER_GRADUATION_ATTENDANCES=9
NEWCOMER_GRADUATION_WINDOW_DAYS=90

# --- Journalisation -------------------------------------------------------
LOG_LEVEL=debug
